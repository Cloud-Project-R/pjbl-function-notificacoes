  "dependencies": {
    "@azure/data-tables": "^13.3.2",
    "@azure/functions": "^4.17.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3"
  }
}
